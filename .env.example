# Copy this file to .env and set a unique SECRET_KEY before starting Django.
SECRET_KEY=

# For a private, same-computer installation only. Keep DEBUG=False for any
# deployment that is reachable by other devices or users.
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Add only exact browser origins if a separate trusted frontend needs the API.
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=

# Optional storage overrides. Defaults are the project db.sqlite3 and media/.
# OPD_DATABASE_PATH=/absolute/path/to/db.sqlite3
# OPD_MEDIA_ROOT=/absolute/path/to/media

# HTTPS-only settings for a properly configured TLS deployment.
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
